.env
.env.local
.env.*.local
# Env-file backups (e.g. .env.bak.<date>, .env.local.bak.<date>) — may hold
# live secrets; never commit. The plain .env rules above don't match .bak.
.env*.bak*
.venv/
node_modules/
frontend/.next/
frontend/node_modules/
backend/.pytest_cache/
backend/.mypy_cache/
**/__pycache__/
*.pyc
*.pyo
*.db
dist/
coverage/

# TypeScript incremental build cache (auto-generated by tsc / npm run build)
*.tsbuildinfo

# Claude Code / AI session artifacts — local working docs, never commit.
# CLAUDE.md at repo root is tracked (repo SOP); this rule only prevents
# additional CLAUDE.md files in subdirs or re-added copies.
.claude/
CLAUDE.md
CLAUDE_CODE_SESSION_PROMPT.md
EVERYTHING_CLAUDE_CODE_RESEARCH.md
PROJECT_ANALYSIS.md
plans/
prompts/cc-cli-*.txt
reports/
# Catch future AI / Claude / prompt / research-note variants at the root.
*_CLAUDE_*.md
*_AI_*.md
*_PROMPT_*.md

# Local handoff / secret-bearing docs — never commit
credentials.md
deployment-report.md
fis-placeholder-handoff.md
email-verification-diagnosis.md

.npm-cache/
.tmp/
logs/

# Playwright MCP session artifacts (snapshots, console logs) written to
# .playwright-mcp/ on every browser interaction. Local-only by nature.
.playwright-mcp/

# Local dev-server output captured by `npm run dev` redirection
# (e.g. `npm run dev > frontend-dev.out.log 2> frontend-dev.err.log`).
# These leak per-developer machine paths into the repo if committed.
frontend-dev.*.log

# ── Local working artifacts / one-off scripts (2026-06-29 housekeeping) ──
# DB dumps + ad-hoc output dirs — large, machine-local, never commit.
/backups/
/db-backups/
/briefs/
/expanded-full.md
/scan96-results.yml
# Per-lane Docker port override generated by the parallel/fleet worktree setup.
docker-compose.override.yml
# Local ops helpers (worktree openers, one-off health checks).
/scripts/ops/
# Ad-hoc one-off diagnostic / data-fix scripts — local working tools, not app code.
/scripts/probe_*.py
/scripts/diag_*.py
/scripts/audit_*.py
/scripts/find_*.py
/scripts/mark_*.py
/scripts/prompt_sweep_*.py
/scripts/verify_drivewealth.py
/scripts/verify_morgan_stanley.py
/scripts/verify_nomura.py
/scripts/refresh_cagr_recoverable.py
/scripts/refresh_morgan_stanley.py
/scripts/refresh_nomura_financials.py
